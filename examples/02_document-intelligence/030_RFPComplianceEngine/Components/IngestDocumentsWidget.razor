@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject HttpClient Http
@inject NavigationManager Navigation
@inject _030_RFPComplianceEngine.Services.FileTextExtractorService FileExtractor
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IAsyncDisposable
@using System.Text.Json

<!-- ══ BATCH INGEST CARD ═════════════════════════════════════════════════════ -->
<div class="card shadow-lg mb-4">
    <div class="card-header bg-secondary text-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-file-earmark-plus me-2"></i>Ingest Documents
        </h5>
        <small class="opacity-75">Upload .txt or .pdf files, set titles, and index them in bulk</small>
    </div>

    <div class="card-body">
        <div class="row g-4">
            <!-- Left: shared settings -->
            <div class="col-12 col-lg-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-card-text me-2 text-secondary"></i>Shared Settings</h6>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Document Type <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="defaultDocType" disabled="@isBatchIngesting">
                        <option value="capability">Company Capabilities</option>
                        <option value="policy">Internal Policies</option>
                        <option value="regulation">Regulatory Frameworks</option>
                        <option value="contract">Contracts</option>
                    </select>
                    <small class="text-muted">Applied to all files unless overridden per file.</small>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Chunk size</label>
                        <input type="number" class="form-control" min="50" max="2000" step="50"
                               @bind="chunkSize" disabled="@isBatchIngesting" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Overlap</label>
                        <input type="number" class="form-control" min="0" max="500" step="10"
                               @bind="chunkOverlap" disabled="@isBatchIngesting" />
                    </div>
                </div>

                @if (fileQueue.Count > 0 && !isBatchIngesting)
                {
                    <button class="btn btn-outline-danger w-100 mt-2" @onclick="ClearAll">
                        <i class="bi bi-trash me-2"></i>Clear All (@fileQueue.Count file(s))
                    </button>
                }
            </div>

            <!-- Right: drop zone + queue -->
            <div class="col-12 col-lg-8">
                <!-- Drop zone -->
                <div id="dropZone"
                     class="upload-zone border rounded-3 d-flex flex-column align-items-center justify-content-center p-4 text-center mb-3"
                     style="min-height:10rem; border-style:dashed !important;">
                    <InputFile id="fileInput" class="visually-hidden"
                               OnChange="OnFilesSelected"
                               accept=".txt,.pdf"
                               multiple
                               maxAllowedFileCount="50"
                               disabled="@isBatchIngesting" />
                    <label for="fileInput" style="cursor:pointer;" class="mb-0">
                        <i class="bi bi-cloud-upload fs-2 text-secondary d-block mb-2"></i>
                        <span class="fw-semibold">Drop files here or click to browse</span>
                        <small class="text-muted d-block mt-1">.txt / .pdf &nbsp;·&nbsp; multiple files supported</small>
                    </label>
                </div>

                @if (!string.IsNullOrEmpty(dropErrorMessage))
                {
                    <div class="alert alert-danger py-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@dropErrorMessage
                    </div>
                }

                <!-- Loading indicator while extracting text -->
                @if (isExtracting)
                {
                    <div class="alert alert-info py-2">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        Extracting text from @extractingFileName...
                    </div>
                }

                <!-- File queue table -->
                @if (fileQueue.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40%">File</th>
                                    <th style="width:22%">Title</th>
                                    <th style="width:16%">Type</th>
                                    <th style="width:10%">Size</th>
                                    <th style="width:12%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (item, idx) in fileQueue.Select((f, i) => (f, i)))
                                {
                                    <tr class="@(item.Status == FileStatus.Error ? "table-danger" : item.Status == FileStatus.Done ? "table-success" : "")">
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-file-earmark-text text-secondary"></i>
                                                <div>
                                                    <div class="fw-semibold text-truncate" style="max-width:200px;"
                                                         title="@item.FileName">@item.FileName</div>
                                                    @if (item.Status == FileStatus.Done)
                                                    {
                                                        <small class="text-success"><i class="bi bi-check-circle me-1"></i>Indexed</small>
                                                    }
                                                    else if (item.Status == FileStatus.Error)
                                                    {
                                                        <small class="text-danger text-truncate d-block" style="max-width:200px;"
                                                               title="@item.ErrorMessage">@item.ErrorMessage</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   value="@item.Title"
                                                   @onchange="e => item.Title = e.Value?.ToString() ?? string.Empty"
                                                   disabled="@(isBatchIngesting || item.Status == FileStatus.Done)"
                                                   placeholder="Auto from filename" />
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm"
                                                    value="@item.DocType"
                                                    @onchange="e => item.DocType = e.Value?.ToString() ?? defaultDocType"
                                                    disabled="@(isBatchIngesting || item.Status == FileStatus.Done)">
                                                <option value="capability">Capability</option>
                                                <option value="policy">Policy</option>
                                                <option value="regulation">Regulation</option>
                                                <option value="contract">Contract</option>
                                            </select>
                                        </td>
                                        <td><small class="text-muted">@FormatSize(item.SizeBytes)</small></td>
                                        <td>
                                            @if (!isBatchIngesting)
                                            {
                                                <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                                        @onclick="() => RemoveFile(idx)"
                                                        title="Remove">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Ingest button + progress -->
                    <div class="mt-3">
                        @if (isBatchIngesting)
                        {
                            <div class="progress mb-2" style="height:1.5rem;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width:@(batchProgress * 100 / fileQueue.Count)%">
                                    @batchProgress / @fileQueue.Count
                                </div>
                            </div>
                            <small class="text-muted">
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                Ingesting @currentIngestingFileName...
                            </small>
                        }
                        else
                        {
                            <button class="btn btn-secondary px-4"
                                    @onclick="IngestAll"
                                    disabled="@(fileQueue.Count == 0 || fileQueue.All(f => f.Status == FileStatus.Done))">
                                <i class="bi bi-cloud-upload me-2"></i>
                                Index All @fileQueue.Count file(s)
                            </button>
                        }
                    </div>
                }

                @if (batchResults.Count > 0)
                {
                    <div class="alert alert-success mt-3" role="alert">
                        <h6 class="alert-heading"><i class="bi bi-check-circle-fill me-2"></i>Batch complete</h6>
                        <p class="mb-1">
                            <strong>@batchResults.Count(r => r.Success)</strong> indexed successfully,
                            <strong>@batchResults.Count(r => !r.Success)</strong> failed.
                        </p>
                        <hr />
                        <small><a href="/" class="alert-link">Go to Analyze page</a> to run RFP compliance analysis.</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ══ INDEX STATUS ══════════════════════════════════════════════════════════ -->
@if (indexStatus != null)
{
    <div class="card shadow-sm">
        <div class="card-header py-2">
            <h6 class="mb-0"><i class="bi bi-database me-2"></i>Current Index Status</h6>
        </div>
        <div class="card-body py-3">
            <div class="row text-center g-3">
                <div class="col-md-3">
                    <div class="fs-4 fw-bold text-primary">@indexStatus.Capabilities.ChunkCount</div>
                    <small class="text-muted">Capability Chunks</small>
                </div>
                <div class="col-md-3">
                    <div class="fs-4 fw-bold text-success">@indexStatus.Policies.ChunkCount</div>
                    <small class="text-muted">Policy Chunks</small>
                </div>
                <div class="col-md-3">
                    <div class="fs-4 fw-bold text-info">@indexStatus.Regulations.ChunkCount</div>
                    <small class="text-muted">Regulation Chunks</small>
                </div>
                <div class="col-md-3">
                    <div class="fs-4 fw-bold text-warning">@indexStatus.Contracts.ChunkCount</div>
                    <small class="text-muted">Contract Chunks</small>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .upload-zone {
        background: #f8f9fa;
        transition: background .15s, border-color .15s;
    }
    .upload-zone:hover, .upload-zone.dragover {
        background: #e9ecef;
        border-color: #0d6efd !important;
    }
</style>

@code {
    private long MaxFileSizeBytes => Configuration.GetValue<long>("Upload:MaxFileSizeMb", 200) * 1024 * 1024;
    private long MaxFileSizeMb    => Configuration.GetValue<long>("Upload:MaxFileSizeMb", 200);

    private string defaultDocType = "capability";
    private int    chunkSize      = 400;
    private int    chunkOverlap   = 50;

    private List<FileQueueItem> fileQueue = new();
    private bool   isBatchIngesting = false;
    private bool   isExtracting     = false;
    private string extractingFileName = string.Empty;
    private int    batchProgress    = 0;
    private string currentIngestingFileName = string.Empty;
    private string dropErrorMessage = string.Empty;

    private List<BatchIngestResult> batchResults = new();
    private IndexStatusPayload?     indexStatus  = null;

    protected override async Task OnInitializedAsync() => await RefreshStatusAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ingestInterop.init", dotNetRef, "dropZone", "fileInput");
        }
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("ingestInterop.cleanup");
    }

    [JSInvokable]
    public async Task OnFilesDropped(int fileCount)
    {
        await JS.InvokeVoidAsync("ingestInterop.openFilePicker");
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        dropErrorMessage = string.Empty;
        var files = e.GetMultipleFiles();
        if (files.Count == 0) return;

        foreach (var file in files)
        {
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (ext != ".txt" && ext != ".pdf")
            {
                dropErrorMessage = $"Skipped '{file.Name}': only .txt and .pdf are supported.";
                continue;
            }
            if (file.Size > MaxFileSizeBytes)
            {
                dropErrorMessage = $"Skipped '{file.Name}': exceeds {MaxFileSizeMb} MB limit.";
                continue;
            }

            isExtracting      = true;
            extractingFileName = file.Name;
            await InvokeAsync(StateHasChanged);

            try
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: MaxFileSizeBytes);
                var text = await FileExtractor.ExtractAsync(stream, file.Name);

                var autoTitle = Path.GetFileNameWithoutExtension(file.Name)
                    .Replace('-', ' ').Replace('_', ' ');

                fileQueue.Add(new FileQueueItem
                {
                    FileName     = file.Name,
                    Title        = autoTitle,
                    DocType      = defaultDocType,
                    Text         = text,
                    SizeBytes    = file.Size,
                    Status       = FileStatus.Queued,
                });
            }
            catch (Exception ex)
            {
                dropErrorMessage = $"Failed to read '{file.Name}': {ex.Message}";
            }
        }

        isExtracting = false;
        extractingFileName = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveFile(int index)
    {
        if (index >= 0 && index < fileQueue.Count)
            fileQueue.RemoveAt(index);
    }

    private void ClearAll()
    {
        fileQueue.Clear();
        batchResults.Clear();
        dropErrorMessage = string.Empty;
    }

    private async Task IngestAll()
    {
        isBatchIngesting = true;
        batchProgress    = 0;
        batchResults     = new();
        await InvokeAsync(StateHasChanged);

        var baseUrl = Navigation.BaseUri.TrimEnd('/');
        var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        foreach (var item in fileQueue.Where(f => f.Status != FileStatus.Done))
        {
            currentIngestingFileName = item.FileName;
            item.Status = FileStatus.Ingesting;
            await InvokeAsync(StateHasChanged);

            try
            {
                var title = string.IsNullOrWhiteSpace(item.Title)
                    ? Path.GetFileNameWithoutExtension(item.FileName).Replace('-', ' ').Replace('_', ' ')
                    : item.Title;

                var response = await Http.PostAsJsonAsync($"{baseUrl}/api/Rfp/ingest", new
                {
                    Text         = item.Text,
                    DocumentId   = (string?)null,
                    Title        = title,
                    DocType      = item.DocType,
                    ChunkSize    = chunkSize,
                    ChunkOverlap = chunkOverlap,
                });

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<IngestResultPayload>(jsonOpts);
                    item.Status = FileStatus.Done;
                    batchResults.Add(new BatchIngestResult { Success = true, FileName = item.FileName });
                }
                else
                {
                    var err = await response.Content.ReadFromJsonAsync<ErrorPayload>(jsonOpts);
                    item.Status       = FileStatus.Error;
                    item.ErrorMessage = err?.Error ?? $"Failed ({(int)response.StatusCode})";
                    batchResults.Add(new BatchIngestResult { Success = false, FileName = item.FileName });
                }
            }
            catch (Exception ex)
            {
                item.Status       = FileStatus.Error;
                item.ErrorMessage = ex.Message;
                batchResults.Add(new BatchIngestResult { Success = false, FileName = item.FileName });
            }

            batchProgress++;
            await InvokeAsync(StateHasChanged);
        }

        isBatchIngesting = false;
        currentIngestingFileName = string.Empty;
        await RefreshStatusAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshStatusAsync()
    {
        try
        {
            var baseUrl  = Navigation.BaseUri.TrimEnd('/');
            var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            indexStatus = await Http.GetFromJsonAsync<IndexStatusPayload>($"{baseUrl}/api/Rfp/status", jsonOpts);
        }
        catch { /* not critical */ }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024          => $"{bytes} B",
        < 1024 * 1024   => $"{bytes / 1024.0:F1} KB",
        _               => $"{bytes / (1024.0 * 1024.0):F1} MB"
    };

    // ── Models ──────────────────────────────────────────────────────────────

    private class FileQueueItem
    {
        public string     FileName     { get; set; } = string.Empty;
        public string     Title        { get; set; } = string.Empty;
        public string     DocType      { get; set; } = "capability";
        public string     Text         { get; set; } = string.Empty;
        public long       SizeBytes    { get; set; }
        public FileStatus Status       { get; set; }
        public string     ErrorMessage { get; set; } = string.Empty;
    }

    private enum FileStatus { Queued, Ingesting, Done, Error }

    private class BatchIngestResult
    {
        public bool   Success  { get; set; }
        public string FileName { get; set; } = string.Empty;
    }

    private class IngestResultPayload
    {
        public bool   Success       { get; set; }
        public string DocumentId    { get; set; } = string.Empty;
        public string DocType       { get; set; } = string.Empty;
        public int    ChunksIndexed { get; set; }
        public int    TotalChunks   { get; set; }
        public int    TotalDocuments { get; set; }
    }

    private class ErrorPayload { public string Error { get; set; } = string.Empty; }

    private class IndexStatusPayload
    {
        public CollectionStats Capabilities { get; set; } = new();
        public CollectionStats Policies     { get; set; } = new();
        public CollectionStats Regulations  { get; set; } = new();
        public CollectionStats Contracts    { get; set; } = new();
    }

    private class CollectionStats
    {
        public int ChunkCount    { get; set; }
        public int DocumentCount { get; set; }
    }
}
