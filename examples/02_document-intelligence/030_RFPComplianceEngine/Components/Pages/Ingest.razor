@page "/ingest"

<PageTitle>Ingest Documents — RFP Compliance Engine</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="display-5">Ingest Documents</h2>
            <p class="text-muted">
                Upload <strong>.txt</strong> or <strong>.pdf</strong> documents for company capabilities, internal policies,
                or regulatory frameworks. Documents are chunked, embedded, and indexed into Qdrant for semantic retrieval
                during RFP analysis.
            </p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12">
            <IngestDocumentsWidget />
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="alert alert-info" role="alert">
                <h5 class="alert-heading"><i class="bi bi-database me-2"></i>Qdrant Vector Storage</h5>
                <p class="mb-0">
                    Documents are stored in three separate Qdrant collections:
                    <code>capabilities</code>, <code>policies</code>, and <code>regulations</code>.
                    Data persists as long as your Qdrant instance is running. Configure the connection
                    in <code>appsettings.local.json</code> under the <code>Qdrant</code> section.
                </p>
            </div>
        </div>
    </div>
</div>
