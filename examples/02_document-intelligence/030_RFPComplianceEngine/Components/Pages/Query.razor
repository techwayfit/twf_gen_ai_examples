@page "/query"

<PageTitle>Query Contracts — RFP Compliance Engine</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="display-5">Query Contracts</h2>
            <p class="text-muted">
                Ask a question across your indexed contract documents. Receive a synthesized answer
                with inline citations pointing to specific contracts and clauses.
            </p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12">
            <ContractQueryWidget />
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="alert alert-info" role="alert">
                <h5 class="alert-heading"><i class="bi bi-info-circle me-2"></i>How It Works</h5>
                <p class="mb-0">
                    The pipeline runs four stages: <strong>embedding</strong> — your question is embedded
                    using the same model used for indexing; <strong>retrieval</strong> — the most relevant
                    contract passages are retrieved via cosine similarity from the Qdrant vector store;
                    <strong>synthesis</strong> — an LLM generates a comprehensive answer using only the
                    retrieved context, with inline [source_N] citations; and <strong>assembly</strong> —
                    the answer and structured citations are returned. Index your contracts first on the
                    <a href="/ingest">Ingest Documents</a> page.
                </p>
            </div>
        </div>
    </div>
</div>
