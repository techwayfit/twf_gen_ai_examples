@using System.Text.Json
@using _036_AI_Pair_Programmer.Models
@inject HttpClient Http
@implements IDisposable

<section class="pair-programmer">
    <div class="panel">
        <h3>Repository Configuration</h3>

        <label>Repository path</label>
        <input @bind="_indexRequest.RepoPath" />

        <label>Languages (comma-separated)</label>
        <input @bind="_languagesCsv" />

        <label>Max files</label>
        <input type="number" min="1" max="2000" @bind="_indexRequest.MaxFiles" />

        <label>Max chunk tokens</label>
        <input type="number" min="200" max="2000" @bind="_indexRequest.MaxChunkTokens" />

        <button @onclick="IndexAsync" disabled="@_busy">Start Indexing</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <p><strong>Status:</strong> @_status</p>
    }

    @if (_indexProgress is not null && _busy)
    {
        <div class="progress-panel">
            <h3>Indexing Progress</h3>
            <div class="progress-bar-container">
                <div class="progress-bar" style="width: @(_indexProgress.PercentComplete)%">
                    <span class="progress-text">@(_indexProgress.PercentComplete)%</span>
                </div>
            </div>
            <div class="progress-details">
                <div><strong>Operation:</strong> @_indexProgress.CurrentOperation</div>
                <div><strong>Progress:</strong> @_indexProgress.ProcessedChunks / @_indexProgress.TotalChunks chunks</div>
                @if (!string.IsNullOrEmpty(_indexProgress.CurrentFile))
                {
                    <div><strong>Current File:</strong> @Path.GetFileName(_indexProgress.CurrentFile)</div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_resultJson))
    {
        <h3>Result</h3>
        <pre>@_resultJson</pre>
    }
</section>

<style>
    .pair-programmer { max-width: 960px; }
    .panel {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
        display: grid;
        gap: 0.5rem;
    }
    .progress-panel {
        border: 1px solid #166534;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
        background: #f0fdf4;
    }
    .progress-bar-container {
        width: 100%;
        height: 30px;
        background: #e5e7eb;
        border-radius: 6px;
        overflow: hidden;
        margin: 1rem 0;
    }
    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #166534 0%, #22c55e 100%);
        transition: width 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
    }
    .progress-text {
        color: #fff;
        font-weight: 600;
        font-size: 0.875rem;
    }
    .progress-details {
        display: grid;
        gap: 0.5rem;
    }
    .progress-details div {
        font-size: 0.875rem;
    }
    input, select, textarea {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 6px;
    }
    button {
        width: fit-content;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        border: 0;
        background: #166534;
        color: #fff;
        font-weight: 600;
    }
    pre {
        background: #111827;
        color: #e5e7eb;
        border-radius: 8px;
        padding: 1rem;
        white-space: pre-wrap;
        word-break: break-word;
    }
</style>

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    private readonly IndexRequest _indexRequest = new();

    private string _languagesCsv = "csharp,razor,markdown";
    private string _status = string.Empty;
    private string _resultJson = string.Empty;
    private bool _busy;
    private string? _currentJobId;
    private System.Threading.Timer? _pollTimer;
    private IndexingProgress? _indexProgress;

    protected override void OnInitialized()
    {
        _indexRequest.RepoPath = Directory.GetCurrentDirectory();
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }

    private async Task IndexAsync()
    {
        if (_busy) return;

        _busy = true;
        _status = "Submitting indexing job...";
        _resultJson = string.Empty;
        _indexProgress = null;

        try
        {
            _indexRequest.Languages = _languagesCsv
                .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .ToList();

            var response = await Http.PostAsJsonAsync("api/PairProgrammer/index/submit", _indexRequest);
            var body = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                _status = "Failed to submit indexing job.";
                _resultJson = body;
                _busy = false;
                return;
            }

            var submitResult = JsonSerializer.Deserialize<JsonElement>(body, _jsonOptions);
            _currentJobId = submitResult.GetProperty("jobId").GetString();
            _status = $"Job submitted: {_currentJobId}. Monitoring progress...";

            // Start polling for progress
            _pollTimer?.Dispose();
            _pollTimer = new System.Threading.Timer(async _ => await PollJobStatusAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
        }
        catch (Exception ex)
        {
            _status = "Failed to submit indexing job.";
            _resultJson = ex.Message;
            _busy = false;
        }
    }

    private async Task PollJobStatusAsync()
    {
        if (string.IsNullOrEmpty(_currentJobId))
        {
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/PairProgrammer/index/status/{_currentJobId}");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var body = await response.Content.ReadAsStringAsync();
            var jobStatus = JsonSerializer.Deserialize<IndexingJobResponse>(body, _jsonOptions);

            if (jobStatus == null)
            {
                return;
            }

            _indexProgress = jobStatus.Progress;

            switch (jobStatus.Status)
            {
                case IndexingJobStatus.Queued:
                    _status = $"Job queued. Waiting to start...";
                    break;

                case IndexingJobStatus.Running:
                    var percent = jobStatus.Progress.PercentComplete;
                    _status = $"Processing: {jobStatus.Progress.CurrentOperation} ({percent}% - {jobStatus.Progress.ProcessedChunks}/{jobStatus.Progress.TotalChunks} chunks)";
                    if (!string.IsNullOrEmpty(jobStatus.Progress.CurrentFile))
                    {
                        _status += $" - {Path.GetFileName(jobStatus.Progress.CurrentFile)}";
                    }
                    break;

                case IndexingJobStatus.Completed:
                    _pollTimer?.Dispose();
                    _pollTimer = null;
                    _status = "Indexing completed successfully!";
                    if (jobStatus.Result != null)
                    {
                        _resultJson = JsonSerializer.Serialize(jobStatus.Result, _jsonOptions);
                    }
                    _busy = false;
                    _currentJobId = null;
                    break;

                case IndexingJobStatus.Failed:
                    _pollTimer?.Dispose();
                    _pollTimer = null;
                    _status = $"Indexing failed: {jobStatus.ErrorMessage}";
                    _busy = false;
                    _currentJobId = null;
                    break;

                case IndexingJobStatus.Cancelled:
                    _pollTimer?.Dispose();
                    _pollTimer = null;
                    _status = "Indexing was cancelled.";
                    _busy = false;
                    _currentJobId = null;
                    break;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // Silently ignore polling errors to avoid spamming logs
            Console.WriteLine($"Polling error: {ex.Message}");
        }
    }
}
