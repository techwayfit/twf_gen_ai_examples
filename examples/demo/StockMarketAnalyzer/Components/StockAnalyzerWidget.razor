@code {
    // ── Form fields ──────────────────────────────────────────────────────────
    [Parameter]
    public string? InitialSymbol { get; set; }

    private string searchQuery = string.Empty;
    private string selectedSymbol = string.Empty;
    private string selectedName = string.Empty;

    // ── Search state ─────────────────────────────────────────────────────────
    private bool isSearching = false;
    private bool showDropdown = false;
    private List<StockSearchResult> searchResults = new();
    private CancellationTokenSource? searchCts;
    private Timer? searchDebounceTimer;

    // ── Analysis state ───────────────────────────────────────────────────────
    private bool   isAnalyzing   = false;
    private bool   watchlistAdded = false;
    private string errorMessage = string.Empty;

    private List<(string Msg, int Idx, bool Done)> stages = new();
    private StockAnalysisResult? result = null;
    private bool initialAnalysisTriggered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(InitialSymbol) && !initialAnalysisTriggered)
        {
            initialAnalysisTriggered = true;
            selectedSymbol = InitialSymbol.ToUpper();
            searchQuery = selectedSymbol;
            await Analyze();
        }
    }

    // ── Search functionality ─────────────────────────────────────────────────

    private async Task OnSearchInputChange(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        showDropdown = !string.IsNullOrWhiteSpace(searchQuery);
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var ct = searchCts.Token;

        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new Timer(async _ =>
        {
            try
            {
                if (string.IsNullOrWhiteSpace(searchQuery) || searchQuery.Length < 1)
                {
                    searchResults = new();
                    isSearching = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                isSearching = true;
                await InvokeAsync(StateHasChanged);

                var baseUrl = Navigation.BaseUri.TrimEnd('/');
                var response = await Http.GetFromJsonAsync<List<StockSearchResult>>(
                    $"{baseUrl}/api/Stock/search?q={Uri.EscapeDataString(searchQuery)}", ct);

                if (!ct.IsCancellationRequested)
                {
                    searchResults = response ?? new();
                    isSearching = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception)
            {
                isSearching = false;
                await InvokeAsync(StateHasChanged);
            }
        }, null, 500, Timeout.Infinite);
    }

    private void SelectSearchResult(StockSearchResult item)
    {
        selectedSymbol = item.Symbol;
        selectedName = item.Name;
        searchQuery = $"{item.Symbol} - {item.Name}";
        showDropdown = false;
        searchResults = new();
        StateHasChanged();
    }

    private void ShowDropdown()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery) && searchResults.Count > 0)
        {
            showDropdown = true;
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            showDropdown = false;
        }
        else if (e.Key == "Enter" && !isAnalyzing)
        {
            showDropdown = false;

            if (!string.IsNullOrEmpty(selectedSymbol))
            {
                await Analyze();
            }
            else if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var possibleSymbol = searchQuery.Split(' ')[0].Trim().ToUpper();
                selectedSymbol = possibleSymbol;
                selectedName = string.Empty;
                searchQuery = possibleSymbol;
                await Analyze();
            }
        }
    }

    // ── Analyze ──────────────────────────────────────────────────────────────
    private async Task Analyze()
    {
        var symbolToAnalyze = selectedSymbol;
        if (string.IsNullOrWhiteSpace(symbolToAnalyze))
        {
            symbolToAnalyze = searchQuery.Split(' ')[0].Trim().ToUpper();
        }

        if (string.IsNullOrWhiteSpace(symbolToAnalyze)) return;

        isAnalyzing = true;
        errorMessage = string.Empty;
        result       = null;
        stages       = new();
        watchlistAdded = false;
        showDropdown = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var baseUrl    = Navigation.BaseUri.TrimEnd('/');
            var requestMsg = new HttpRequestMessage(HttpMethod.Post, $"{baseUrl}/api/Stock/analyze");

            requestMsg.Content = JsonContent.Create(new
            {
                Symbol = symbolToAnalyze.ToUpper()
            });

            using var response = await Http.SendAsync(requestMsg, HttpCompletionOption.ResponseHeadersRead);
            using var stream   = await response.Content.ReadAsStreamAsync();
            using var reader   = new System.IO.StreamReader(stream);

            var jsonOpts       = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            string? pendingEvt = null;

            while (!reader.EndOfStream)
            {
                var line = await reader.ReadLineAsync();
                if (line == null) break;

                if (line.StartsWith("event: "))
                {
                    pendingEvt = line[7..].Trim();
                }
                else if (line.StartsWith("data: "))
                {
                    var data = line[6..];

                    switch (pendingEvt)
                    {
                        case "stage":
                            var stageEvt = JsonSerializer.Deserialize<StageEventPayload>(data, jsonOpts);
                            if (stageEvt != null)
                            {
                                for (int i = 0; i < stages.Count; i++)
                                    stages[i] = (stages[i].Msg, stages[i].Idx, true);
                                stages.Add((stageEvt.Message, stageEvt.StageIndex, false));
                            }
                            await InvokeAsync(StateHasChanged);
                            break;

                        case "complete":
                            result = JsonSerializer.Deserialize<StockAnalysisResult>(data, jsonOpts);
                            for (int i = 0; i < stages.Count; i++)
                                stages[i] = (stages[i].Msg, stages[i].Idx, true);
                            await InvokeAsync(StateHasChanged);
                            break;

                        case "error":
                            var err = JsonSerializer.Deserialize<ErrorPayload>(data, jsonOpts);
                            errorMessage = err?.Error ?? "Analysis failed.";
                            await InvokeAsync(StateHasChanged);
                            break;
                    }

                    pendingEvt = null;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Reset ────────────────────────────────────────────────────────────────
    private void Reset()
    {
        searchQuery      = string.Empty;
        selectedSymbol   = string.Empty;
        selectedName     = string.Empty;
        errorMessage     = string.Empty;
        result           = null;
        stages           = new();
        watchlistAdded   = false;
        showDropdown     = false;
        searchResults    = new();
        StateHasChanged();
    }

    // ── Add to watchlist ─────────────────────────────────────────────────────
    private async Task AddToWatchlist()
    {
        if (result == null) return;

        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var response = await Http.PostAsJsonAsync($"{baseUrl}/api/Watchlist",
                new { Symbol = result.Symbol });

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                watchlistAdded = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to add to watchlist: {ex.Message}");
        }
    }

    // ── Badge helpers ────────────────────────────────────────────────────────
    private static string GetDirectionBadgeClass(string direction) => direction.ToLower() switch
    {
        "bullish"  => "bg-success",
        "bearish"  => "bg-danger",
        _          => "bg-secondary"
    };

    private static string GetRecommendationBadgeClass(string action) => action.ToLower() switch
    {
        "buy"  => "bg-success",
        "sell" => "bg-danger",
        _      => "bg-warning"
    };

    private static string GetRiskBadgeClass(string level) => level.ToLower() switch
    {
        "low"    => "bg-success",
        "high"   => "bg-danger",
        _        => "bg-warning"
    };

    // ── SSE payload types ────────────────────────────────────────────────────
    private class StageEventPayload
    {
        public string Message     { get; set; } = string.Empty;
        public int    StageIndex  { get; set; }
        public int    TotalStages { get; set; }
    }

    private class ErrorPayload
    {
        public string Error { get; set; } = string.Empty;
    }
}
