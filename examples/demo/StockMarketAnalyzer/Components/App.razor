<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Bootstrap CSS from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Bootstrap Icons from CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="app.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>window.copyToClipboard = (t) => navigator.clipboard.writeText(t);</script>

    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" crossorigin="anonymous"></script>
    <script>
        window.chartInstances = {};

        // Log when Chart.js is loaded
        console.log('[Chart] Initializing chart functions. Chart.js available:', typeof Chart !== 'undefined');

        window.createStockChart = (canvasId, labels, prices, volumes) => {
            console.log('[Chart] createStockChart called for:', canvasId);
            console.log('[Chart] Chart.js status:', typeof Chart !== 'undefined' ? 'loaded' : 'NOT LOADED');

            const ctx = document.getElementById(canvasId);
            if (!ctx) {
                console.warn('[Chart] Canvas not found:', canvasId);
                return;
            }
            if (typeof Chart === 'undefined') {
                console.error('[Chart] Chart.js not loaded yet. Retrying in 100ms...');
                setTimeout(() => window.createStockChart(canvasId, labels, prices, volumes), 100);
                return;
            }

            try {
            if (window.chartInstances[canvasId]) {
                window.chartInstances[canvasId].destroy();
            }

            const gridColor = 'rgba(255, 255, 255, 0.08)';
            const tickColor = '#9ca3af';

            window.chartInstances[canvasId] = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Closing Price',
                            data: prices,
                            borderColor: '#818cf8',
                            backgroundColor: 'rgba(129, 140, 248, 0.1)',
                            fill: true,
                            tension: 0.3,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            pointHoverBackgroundColor: '#818cf8',
                            borderWidth: 2,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Volume',
                            data: volumes,
                            type: 'bar',
                            backgroundColor: 'rgba(99, 102, 241, 0.2)',
                            borderColor: 'rgba(99, 102, 241, 0.4)',
                            borderWidth: 0,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: {
                                color: tickColor,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                padding: 20,
                                font: { size: 12 }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(28, 28, 46, 0.95)',
                            titleColor: '#e8e8f0',
                            bodyColor: '#9ca3af',
                            borderColor: 'rgba(99, 102, 241, 0.3)',
                            borderWidth: 1,
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: function(context) {
                                    if (context.dataset.label === 'Volume') {
                                        return 'Volume: ' + context.parsed.y.toLocaleString();
                                    }
                                    return 'Price: $' + context.parsed.y.toFixed(2);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            display: true,
                            grid: { color: gridColor, drawBorder: false },
                            ticks: {
                                color: tickColor,
                                maxTicksLimit: 8,
                                font: { size: 11 }
                            }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            grid: { color: gridColor, drawBorder: false },
                            ticks: {
                                color: tickColor,
                                callback: function(value) { return '$' + value.toFixed(0); }
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: false,
                            position: 'right',
                            grid: { drawOnChartArea: false }
                        }
                    }
                }
            });
            console.log('[Chart] Chart created successfully for:', canvasId);
            } catch (error) {
                console.error('[Chart] Error creating chart:', error);
            }
        };

        window.destroyChart = (canvasId) => {
            if (window.chartInstances[canvasId]) {
                window.chartInstances[canvasId].destroy();
                delete window.chartInstances[canvasId];
            }
        };
    </script>

    <!-- Bootstrap JS Bundle with Popper from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>

</html>
